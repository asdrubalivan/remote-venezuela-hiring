strict-dep-builds=false
verify-deps-before-run=false

# Supply-chain hardening: refuse to install package versions published
# less than 24h ago. Mitigates rug-pulls and freshly-compromised releases
# that haven't had time to be detected/yanked. Value is in minutes.
# Requires pnpm >= 10.16. https://pnpm.io/settings#minimumreleaseage
minimum-release-age=1440
